# every config key this project reads, with placeholder values.

ALPACA_KEY_ID=your-alpaca-key-id
ALPACA_SECRET_KEY=your-alpaca-secret-key

# paper-api for a paper-only account, api for a funded live account.
# bars always come from data.alpaca.markets, where the wrong host returns a 403 that reads like a bad key.
ALPACA_TRADING_HOST=https://paper-api.alpaca.markets
ALPACA_FEED=iex
ALPACA_ADJUSTMENT=split,spin-off
ALPACA_LIMIT=10000

INGEST_START=2020-08-01
INGEST_END=2026-06-30

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/marketdata

RATE_LIMIT_RPM=200
HTTP_MAX_ATTEMPTS=5
AGG_MAX_WINDOW_DAYS=90
# the hot-window partial index's predicate and the month list Feature 10 copies to RDS.
# counted back from INGEST_END's month, at least 1, and the API refuses to start unless it
# reaches AGG_MAX_WINDOW_DAYS before INGEST_END, the widest window the aggregating endpoints
# accept -- /bars takes the whole ingested range.
HOT_WINDOW_MONTHS=4

# page caps. BARS_* and AGG_* were both measured against the loaded database and confirmed at
# these values, each at its own default and its own max; docs/QUERY_PERFORMANCE.md carries the
# per-page block counts behind that, and AGG_* is confirmed on /analytics/largest-moves, the one
# endpoint reading it that fills a page at the default -- at min_move_pct = 0; a positive
# threshold reads further, and docs/QUERY_PERFORMANCE.md carries what that costs.
BARS_PAGE_DEFAULT=1000
BARS_PAGE_MAX=10000
AGG_PAGE_DEFAULT=100
AGG_PAGE_MAX=1000
DB_POOL_MIN=1
DB_POOL_MAX=10
LOG_LEVEL=INFO

# the end-to-end suite's target. the window must run at least two days, span at most
# AGG_MAX_WINDOW_DAYS (four endpoints refuse a longer one) and sit inside the hot window the
# deploy copies, with AGG_MAX_WINDOW_DAYS + 1 days of that hot window before E2E_END for the
# over-the-cap request, so the same suite runs locally and against the deployed database. the
# suite reports a window that breaks these, or an empty E2E_BASE_URL or E2E_SYMBOLS, by name
# before its first request.
E2E_BASE_URL=http://127.0.0.1:8000
E2E_START=2026-04-01
E2E_END=2026-06-30
E2E_SYMBOLS=AAPL,MSFT,NVDA

# left empty on purpose: these four keys read an empty value as unset, so this file constructs
# as it stands; require() names the key at use, and docs/METHODOLOGY.md carries the value and the
# arithmetic. an empty value for any other key is refused or reported, never replaced by a default.
BARS_PER_TICKER_DAY=
DEEP_PAGE_DEPTH=
# the PK ratio, which queries 9 and 10 are judged against.
HEAP_INDEX_BYTE_RATIO=
# query 7's ratio, against the covering index -- a different index and a different number.
HEAP_INDEX_COVERING_RATIO=
